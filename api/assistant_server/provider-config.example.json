        "model_generation",
        "registry_object",
        "study",
        "training_run"
      ],
      "fallback_provider": "local"
    },
    "remote_lab_slm": {
      "type": "openai_compatible",
      "enabled": true,
      "base_url": "https://assistant-runtime.example.com/v1",
      "health_url": "https://assistant-runtime.example.com/health",
      "model_name": "remote-amanaje-draft-model",
      "model_version": "remote-amanaje-draft-model-0.1",
      "api_key_env": "REMOTE_LAB_SLM_API_KEY",
      "timeout_seconds": 60,
      "max_tokens": 3000,
      "temperature": 0.2,
      "fallback_provider": "local"
    }
  }
