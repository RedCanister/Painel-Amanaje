{
  "active_provider": "amanaje_slm",
  "providers": {
    "amanaje_slm": {
      "type": "openai_compatible",
      "enabled": true,
      "base_url": "http://localhost:8080/v1",
      "health_url": "http://localhost:8080/health",
      "model_name": "amanaje-assistant",
      "model_version": "amanaje-slm-local-0.1",
      "base_model_name": "local-foundation-model",
