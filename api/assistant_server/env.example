AMANAJE_ASSISTANT_ACTIVE_PROVIDER=amanaje_slm
AMANAJE_ASSISTANT_PROVIDER_CONFIG_PATH=api/assistant_server/provider-config.example.json
AMANAJE_ASSISTANT_MLFLOW_ENABLED=true
AMANAJE_ASSISTANT_MLFLOW_EXPERIMENT=assistant/amanaje_slm

# Legacy single-provider alias for amanaje_slm.
AMANAJE_SLM_ENABLED=true
AMANAJE_SLM_BASE_URL=http://localhost:8080/v1
AMANAJE_SLM_MODEL_NAME=amanaje-assistant
AMANAJE_SLM_MODEL_VERSION=amanaje-slm-local-0.1
AMANAJE_SLM_TIMEOUT_SECONDS=45
AMANAJE_SLM_MAX_TOKENS=2500
AMANAJE_SLM_TEMPERATURE=0.2

# Optional auth for external providers.
# REMOTE_LAB_SLM_API_KEY=replace-me
